# ============================================================
#  قالب متغيّرات البيئة — m7nmri-byte/7
#  انسخ هذا الملف إلى .env ثم املأ القيم. ملف .env لا يُرفع إلى GitHub.
#  كل القيم أدناه خاصة بهذا المشروع وحده — لا تشارك حسابات المشاريع الأخرى.
# ============================================================

# ------------------------------------------------------------
#  Supabase  →  قاعدة البيانات والمصادقة والتخزين
#  من: supabase.com/dashboard  >  المشروع  >  Project Settings
# ------------------------------------------------------------

# كلمة مرور قاعدة البيانات — تظهر مرة واحدة فقط عند إنشاء المشروع.
# الصقها هنا فوراً، وستُستخدم بعد قليل داخل DATABASE_URL و DIRECT_URL.
SUPABASE_DB_PASSWORD=

# Settings > API  >  Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Settings > API Keys  >  المفتاح العام (anon / publishable)
# يُستخدم في المتصفح — آمن للكشف
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings > API Keys  >  المفتاح السري (service_role / secret)
# ⚠ يتجاوز كل صلاحيات RLS — للخادم فقط، لا يوضع في كود المتصفح أبداً
SUPABASE_SERVICE_ROLE_KEY=

# زر Connect (أعلى اللوحة)  >  ORMs  >  Prisma
# DATABASE_URL = اتصال عبر الـ pooler (منفذ 6543)
DATABASE_URL=
# DIRECT_URL = اتصال مباشر (منفذ 5432) — تستخدمه الهجرات
DIRECT_URL=

# معرّف المشروع (الجزء العشوائي من رابط المشروع)
SUPABASE_PROJECT_REF=

# توكن خاص بأداة supabase CLI لهذا المشروع.
# استخدمه بدل الأمر `supabase login` حتى لا يُستبدل توكن مشاريعك الأخرى.
# من: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=


# ------------------------------------------------------------
#  Cloudinary  →  الصور والوسائط
#  من: console.cloudinary.com  >  Settings > API Keys
# ------------------------------------------------------------

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# صيغة مختصرة تجمع الثلاثة أعلاه — تقرأها مكتبة cloudinary تلقائياً.
# الشكل: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# اسم الحساب فقط، لاستخدامه في المتصفح (آمن للكشف)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=


# ------------------------------------------------------------
#  Vercel  →  الاستضافة والنشر
#  الربط الأساسي يتم من لوحة Vercel (استيراد المستودع من GitHub).
#  القيم أدناه تلزم فقط إذا استخدمت أداة vercel CLI.
# ------------------------------------------------------------

# من: vercel.com/account/tokens
# استخدمه بدل `vercel login` حتى لا يُستبدل توكن مشاريعك الأخرى.
VERCEL_TOKEN=

# تُنشَآن تلقائياً في .vercel/project.json بعد أول `vercel link`
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
